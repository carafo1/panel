# Files that run on the Linux server must keep Linux line endings (LF).
# With Windows line endings bash fails on the first line
# (e.g. "set: pipefail\r: invalid option"), and systemd/cloud-init/Caddy
# configs can misread values. This holds no matter how git is configured on
# the machine that commits them.
*.sh            text eol=lf
deploy/**       text eol=lf
deploy/bin/*    text eol=lf
mini-services/**/*.sh text eol=lf
Caddyfile       text eol=lf

# Binary files must never be converted, including those under deploy/
# (the deploy/** rule above would otherwise treat them as text and corrupt
# them). These lines come last so they win.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.pdf           binary
*.zip           binary
*.gz            binary
