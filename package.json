{
  "name": "apsamo-panel",
  "version": "0.2.0",
  "private": true,
  "bin": {
    "deployhub": "./cli/deployhub.mjs"
  },
  "scripts": {
    "predev": "bun run scripts/ensure-dynadot-env.ts",
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "ensure-env": "bun run scripts/ensure-dynadot-env.ts",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/ && mkdir -p .next/standalone/node_modules/@prisma && cp -r node_modules/.prisma .next/standalone/node_modules/ && cp -r node_modules/@prisma/client .next/standalone/node_modules/@prisma/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "test": "bun test --preload ./tests/unit/preload.ts tests/unit/",
    "test:scenarios": "bun test --preload ./tests/scenarios/preload.ts tests/scenarios/",
    "typecheck": "tsc --noEmit -p .",
    "test:integration": "bun test tests/integration/",
    "test:e2e": "playwright test",
    "test:all": "bun run test && bun run test:scenarios && bun run test:integration",
    "test:security": "bash deploy/scripts/comprehensive-security-scan.sh",
    "db:push": "prisma db push",
    "db:pg-schema": "bun run scripts/postgres-schema.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
