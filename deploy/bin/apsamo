#!/usr/bin/env bash
# ════════════════════════════════════════════════════════════════════════════
# apsamo — Admin CLI for Apsamo Panel
# ════════════════════════════════════════════════════════════════════════════
#
#   Usage:
#     apsamo status           — show status of all services
#     apsamo start            — start all services
#     apsamo stop             — stop all services
#     apsamo restart [svc]    — restart all (or one: panel|realtime|worker)
#     apsamo logs [svc]       — tail logs (panel|realtime|worker|caddy)
#     apsamo backup           — create a backup now
#     apsamo restore <file>   — restore from a backup tarball
#     apsamo update           — git pull + rebuild + restart (zero downtime)
#     apsamo create-admin     — create or reset the admin user
#     apsamo reset-password   — reset a user's password
#     apsamo db-shell         — open SQLite shell on the panel DB
#     apsamo db-push          — push Prisma schema (after code updates)
#     apsamo db-reset         — ⚠ DESTRUCTIVE — drops & recreates the DB
#     apsamo seed             — re-seed plans, servers, templates
#     apsamo env              — edit the .env file
#     apsamo reload-caddy     — validate + reload Caddy config
#     apsamo doctor           — diagnose common issues
#     apsamo version          — show installed version
#     apsamo help             — show this help
#
# ════════════════════════════════════════════════════════════════════════════

set -euo pipefail

INSTALL_DIR="__INSTALL_DIR__"
SERVICES=(apsamo-panel apsamo-realtime apsamo-worker)

# ── Colors ────────────────────────────────────────────────────────────────
RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'; BOLD=$'\033[1m'; DIM=$'\033[2m'; NC=$'\033[0m'
ok()   { echo "${GREEN}✓${NC} $*"; }
warn() { echo "${YELLOW}!${NC} $*"; }
err()  { echo "${RED}✗${NC} $*" >&2; }

# ── Helpers ───────────────────────────────────────────────────────────────
service_status() {
  local svc=$1
  local status
  status=$(systemctl is-active "$svc" 2>/dev/null || echo "unknown")
  case "$status" in
    active)   echo "${GREEN}●${NC} $svc" ;;
    inactive) echo "${RED}○${NC} $svc" ;;
    failed)   echo "${RED}✗${NC} $svc (failed)" ;;
    *)        echo "${YELLOW}?${NC} $svc ($status)" ;;
  esac
}

tail_log() {
  local svc=$1
  case "$svc" in
    panel|apsamo-panel)    tail -f "$INSTALL_DIR/logs/panel.log" 2>/dev/null || journalctl -u apsamo-panel -f ;;
    realtime|apsamo-realtime) tail -f "$INSTALL_DIR/logs/realtime.log" 2>/dev/null || journalctl -u apsamo-realtime -f ;;
    worker|apsamo-worker)  tail -f "$INSTALL_DIR/logs/worker.log" 2>/dev/null || journalctl -u apsamo-worker -f ;;
    caddy)                 journalctl -u caddy -f ;;
    *)                     err "Unknown log: $svc"; exit 1 ;;
  esac
}

# ── Commands ──────────────────────────────────────────────────────────────

cmd_status() {
  echo "${BOLD}═══ Apsamo Panel — Service Status ═══${NC}"
  echo ""
  for svc in "${SERVICES[@]}" caddy; do
    service_status "$svc"
  done
  echo ""
  echo "${BOLD}═══ Listening ports ═══${NC}"
  ss -ltnp 2>/dev/null | grep -E ':(3000|3003|3004|3005|80|443)\b' | awk '{print "  " $4 " " $6}' || warn "ss not available"
  echo ""
  echo "${BOLD}═══ Disk usage ═══${NC}"
  du -sh "$INSTALL_DIR" 2>/dev/null | awk '{print "  install: " $1}'
  du -sh "$INSTALL_DIR/db" 2>/dev/null | awk '{print "  db:      " $1}'
  du -sh "$INSTALL_DIR/storage" 2>/dev/null | awk '{print "  storage: " $1}'
  du -sh "$INSTALL_DIR/logs" 2>/dev/null | awk '{print "  logs:    " $1}'
  echo ""
  echo "${BOLD}═══ Recent backups ═══${NC}"
  ls -lt "$INSTALL_DIR"/backups/*.tar.gz 2>/dev/null | head -5 | awk '{print "  " $6 " " $7 " " $8 "  " $9}' || warn "no backups yet"
}

cmd_start()   { for svc in "${SERVICES[@]}"; do systemctl start "$svc" && ok "started $svc"; done; }
cmd_stop()    { for svc in "${SERVICES[@]}"; do systemctl stop "$svc"  && ok "stopped $svc"; done; }

cmd_restart() {
  local svc=${1:-all}
  if [[ "$svc" == "all" ]]; then
    for s in "${SERVICES[@]}"; do systemctl restart "$s" && ok "restarted $s"; done
  else
    systemctl restart "$svc" && ok "restarted $svc"
  fi
}

cmd_logs() {
  local svc=${1:-panel}
  tail_log "$svc"
}

cmd_backup() {
  bash "$INSTALL_DIR/deploy/scripts/backup.sh" "$@"
}

cmd_restore() {
  if [[ $# -lt 1 ]]; then
    err "Usage: apsamo restore <backup.tar.gz>"
    exit 1
  fi
  bash "$INSTALL_DIR/deploy/scripts/restore.sh" "$1"
}

cmd_update() {
  bash "$INSTALL_DIR/deploy/scripts/update.sh" "$@"
}

cmd_create_admin() {
  local email="${1:-}"
  local password="${2:-}"
  if [[ -z "$email" ]]; then
    read -rp "Admin email: " email
  fi
  if [[ -z "$password" ]]; then
    read -rsp "Admin password (min 8 chars): " password
    echo
  fi
  if [[ ${#password} -lt 8 ]]; then
    err "Password must be at least 8 characters."
    exit 1
  fi

  cd "$INSTALL_DIR"
  bun -e "
const { db } = require('./src/lib/db');
const bcrypt = require('bcryptjs');
(async () => {
  const existing = await db.user.findFirst({ where: { email: '${email}' } });
  const hashed = await bcrypt.hash('${password}', 12);
  if (existing) {
    await db.user.update({
      where: { id: existing.id },
      data: { password: hashed, role: 'super_admin', emailVerified: true },
    });
    console.log('Admin password reset for:', '${email}');
  } else {
    const u = await db.user.create({
      data: {
        email: '${email}',
        name: 'Administrator',
        password: hashed,
        role: 'super_admin',
        emailVerified: true,
      },
    });
    console.log('Admin created:', u.email);
  }
  process.exit(0);
})();
"
  ok "Admin ready: $email"
}

cmd_reset_password() {
  local email="${1:-}"
  local password="${2:-}"
  if [[ -z "$email" ]]; then
    read -rp "User email: " email
  fi
  if [[ -z "$password" ]]; then
    read -rsp "New password: " password
    echo
  fi
  cd "$INSTALL_DIR"
  bun -e "
const { db } = require('./src/lib/db');
const bcrypt = require('bcryptjs');
(async () => {
  const u = await db.user.findUnique({ where: { email: '${email}' } });
  if (!u) { console.error('User not found'); process.exit(1); }
  const hashed = await bcrypt.hash('${password}', 12);
  await db.user.update({ where: { id: u.id }, data: { password: hashed } });
  console.log('Password reset for:', u.email);
  process.exit(0);
})();
"
  ok "Password reset for $email"
}

cmd_db_shell() {
  cd "$INSTALL_DIR"
  local db_url
  db_url=$(grep '^DATABASE_URL=' .env | cut -d'"' -f2)
  local db_path="${db_url#file:}"

  if command -v sqlite3 &>/dev/null; then
    sqlite3 "$db_path"
  else
    warn "sqlite3 not installed — using bun-based REPL"
    bun -e "
const { Database } = require('bun:sqlite');
const db = new Database('${db_path}');
process.stdin.on('data', (chunk) => {
  const sql = chunk.toString().trim().replace(/;$/, '');
  if (!sql || sql === '.quit' || sql === '.exit') { process.exit(0); }
  try {
    const rows = db.prepare(sql).all();
    console.log(JSON.stringify(rows, null, 2));
  } catch (e) {
    console.error('Error:', e.message);
  }
  process.stdout.write('> ');
});
process.stdout.write('> ');
"
  fi
}

cmd_db_push() {
  cd "$INSTALL_DIR"
  bun run db:push
  ok "Schema pushed"
}

cmd_db_reset() {
  warn "This will DROP and recreate the database. All data will be lost."
  read -rp "Type 'yes' to continue: " confirm
  [[ "$confirm" == "yes" ]] || { echo "Aborted."; exit 0; }
  cd "$INSTALL_DIR"
  bun run db:push --force-reset
  bun run scripts/run-seed.ts
  bun run scripts/seed-templates-and-payment.ts
  ok "Database reset and re-seeded"
}

cmd_seed() {
  cd "$INSTALL_DIR"
  bun run scripts/run-seed.ts
  bun run scripts/seed-templates-and-payment.ts
  ok "Database seeded"
}

cmd_env() {
  ${EDITOR:-vi} "$INSTALL_DIR/.env"
  warn "Restart services to apply changes: apsamo restart"
}

cmd_reload_caddy() {
  caddy validate --config /etc/caddy/Caddyfile && \
  systemctl reload caddy && \
  ok "Caddy reloaded"
}

cmd_switch_db() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    echo "Usage: apsamo switch-db <sqlite|postgres>"
    echo ""
    echo "  apsamo switch-db postgres   # migrate SQLite → PostgreSQL + pgvector"
    echo "  apsamo switch-db sqlite     # rollback to SQLite (uses saved .env.pre-postgres)"
    return 1
  fi
  case "$target" in
    postgres|postgresql)
      bash "$INSTALL_DIR/deploy/scripts/switch-to-postgres.sh"
      ;;
    sqlite)
      bash "$INSTALL_DIR/deploy/scripts/switch-to-postgres.sh" --rollback
      ;;
    *)
      err "Unknown DB engine: $target (use 'sqlite' or 'postgres')"
      return 1
      ;;
  esac
}

cmd_populate_embeddings() {
  cd "$INSTALL_DIR"
  bun run scripts/populate-embeddings.ts
}

cmd_search() {
  local query="${*:-}"
  if [[ -z "$query" ]]; then
    err "Usage: apsamo search <natural language query>"
    return 1
  fi
  cd "$INSTALL_DIR"
  # Get admin token from .env-derived credentials (just use the first admin user)
  local token
  token=$(bun -e "
const { db } = require('./src/lib/db');
const { sign } = require('jsonwebtoken');
(async () => {
  const admin = await db.user.findFirst({ where: { role: { in: ['admin', 'super_admin'] } } });
  if (!admin) { process.exit(1); }
  const t = sign({ userId: admin.id, email: admin.email, role: admin.role }, process.env.JWT_SECRET, { expiresIn: '1h' });
  console.log(t);
  process.exit(0);
})();
" 2>/dev/null)
  if [[ -z "$token" ]]; then
    err "Could not generate admin token"
    return 1
  fi
  curl -s "http://localhost:3000/api/assistant/search?q=$(printf '%s' "$query" | jq -sRr @uri)&limit=10" \
    -H "Authorization: Bearer $token" | jq .
}

cmd_verify() {
  bash "$INSTALL_DIR/deploy/scripts/post-install-verify.sh" "$@"
}

cmd_monitor() {
  bash "$INSTALL_DIR/deploy/scripts/health-monitor.sh" "$@"
}

cmd_setup_monitoring() {
  bash "$INSTALL_DIR/deploy/scripts/setup-monitoring.sh" "$@"
}

cmd_doctor() {
  echo ""
  echo "${BOLD}[OS]${NC}"
  if [[ -f /etc/os-release ]]; then
    . /etc/os-release
    ok "OS: $PRETTY_NAME"
  else
    err "Cannot detect OS"
  fi
  echo ""
  echo "${BOLD}[Required commands]${NC}"
  for cmd in bun node docker caddy systemctl sqlite3 git openssl; do
    if command -v "$cmd" &>/dev/null; then
      ok "$cmd → $(command -v "$cmd")"
    else
      err "$cmd not found"
    fi
  done
  echo ""
  echo "${BOLD}[Install dir]${NC}"
  [[ -d "$INSTALL_DIR" ]] && ok "install dir exists: $INSTALL_DIR" || err "install dir missing"
  [[ -f "$INSTALL_DIR/.env" ]] && ok ".env exists" || err ".env missing"
  [[ -f "$INSTALL_DIR/.next/standalone/server.js" ]] && ok "build output exists" || err "build output missing — run: apsamo build"
  local db_url
  db_url=$(grep '^DATABASE_URL=' "$INSTALL_DIR/.env" 2>/dev/null | cut -d'"' -f2)
  local db_path="${db_url#file:}"
  [[ -f "$db_path" ]] && ok "database exists ($db_path)" || err "database missing — run: apsamo db-push"
  echo ""
  echo "${BOLD}[Services]${NC}"
  for svc in "${SERVICES[@]}" caddy; do
    service_status "$svc"
  done
  echo ""
  echo "${BOLD}[Network]${NC}"
  curl -s -o /dev/null -w "  panel (HTTP 200 expected):  %{http_code}\n" http://localhost:3000/ 2>/dev/null || err "panel not responding"
  curl -s -o /dev/null -w "  realtime (HTTP 200 expected): %{http_code}\n" http://localhost:3003/health 2>/dev/null || err "realtime not responding"
  curl -s -o /dev/null -w "  worker (HTTP 200 expected):  %{http_code}\n" http://localhost:3005/health 2>/dev/null || err "worker not responding"
  echo ""
  echo "${BOLD}[Disk space]${NC}"
  df -h "$INSTALL_DIR" | tail -1 | awk '{print "  " $4 " free on " $6}'
  echo ""
  echo "${BOLD}[Recent errors (last 10)]${NC}"
  grep -E 'ERROR|Error|failed' "$INSTALL_DIR/logs/panel.log" 2>/dev/null | tail -10 || ok "no errors in panel log"
}

cmd_version() {
  cd "$INSTALL_DIR"
  local pkg_version
  pkg_version=$(grep '"version"' package.json | head -1 | cut -d'"' -f4)
  echo "Apsamo Panel v$pkg_version"
  echo "Install dir: $INSTALL_DIR"
  echo "Bun: $(bun --version)"
  echo "Node: $(node --version)"
  echo "Docker: $(docker --version 2>/dev/null | awk '{print $3}' | tr -d ',')"
  echo "Caddy: $(caddy version 2>&1 | head -1)"
}

cmd_help() {
  cat <<'EOF'
══════════════════════════════════════════════════════════════════════════
  apsamo — Admin CLI for Apsamo Panel
══════════════════════════════════════════════════════════════════════════

Service management:
  apsamo status             Show status of all services + disk usage + recent backups
  apsamo start              Start all services
  apsamo stop               Stop all services
  apsamo restart [svc]      Restart all (or: panel | realtime | worker)
  apsamo logs [svc]         Tail logs (panel | realtime | worker | caddy)

Backups:
  apsamo backup             Create a backup now (DB + storage + .env)
  apsamo restore <file>     Restore from a backup tarball

Updates:
  apsamo update             git pull + rebuild + restart (zero downtime)

User management:
  apsamo create-admin [email] [password]   Create or reset the admin user
  apsamo reset-password [email] [password] Reset any user's password

Database:
  apsamo db-shell           Open SQLite shell on the panel DB
  apsamo db-push            Push Prisma schema (after code updates)
  apsamo db-reset           ⚠ DESTRUCTIVE — drops & recreates the DB
  apsamo seed               Re-seed plans, servers, templates

Configuration:
  apsamo env                Edit .env in $EDITOR (default: vi)
  apsamo reload-caddy       Validate + reload Caddy config
  apsamo switch-db <engine> Switch DB engine (sqlite ↔ postgres + pgvector)
  apsamo populate-embeddings  Populate pgvector embeddings for AI semantic search
  apsamo search <query>     Semantic search across your projects/deployments/logs

Diagnostics:
  apsamo doctor             Diagnose common issues (OS, deps, services, network)
  apsamo verify             Full post-install verification (12 checks, exit 0 if all pass)
  apsamo monitor            Run health check now (8 checks: panel, realtime, worker, DB, disk, memory, SSL, backups)
  apsamo setup-monitoring   Install cron + alerting (use --webhook <url> or --email <addr>)
  apsamo version            Show installed version + runtime versions
  apsamo help               Show this help

Examples:
  apsamo restart panel                  # restart only the panel
  apsamo logs worker                    # tail worker logs
  apsamo create-admin admin@x.com S3cr3t!Pass   # create admin non-interactively
  apsamo backup --keep 7                # backup, keep only last 7

══════════════════════════════════════════════════════════════════════════
EOF
}

# ── Main ──────────────────────────────────────────────────────────────────
case "${1:-help}" in
  status)         cmd_status ;;
  start)          cmd_start ;;
  stop)           cmd_stop ;;
  restart)        shift; cmd_restart "${1:-all}" ;;
  logs)           shift; cmd_logs "${1:-panel}" ;;
  backup)         shift; cmd_backup "$@" ;;
  restore)        shift; cmd_restore "$@" ;;
  update)         shift; cmd_update "$@" ;;
  create-admin)   shift; cmd_create_admin "$@" ;;
  reset-password) shift; cmd_reset_password "$@" ;;
  db-shell)       cmd_db_shell ;;
  db-push)        cmd_db_push ;;
  db-reset)       cmd_db_reset ;;
  seed)           cmd_seed ;;
  env)            cmd_env ;;
  reload-caddy)   cmd_reload_caddy ;;
  switch-db)      shift; cmd_switch_db "$@" ;;
  populate-embeddings) cmd_populate_embeddings ;;
  search)         shift; cmd_search "$@" ;;
  doctor)         cmd_doctor ;;
  verify)         shift; cmd_verify "$@" ;;
  monitor)        cmd_monitor ;;
  setup-monitoring) shift; cmd_setup_monitoring "$@" ;;
  version)        cmd_version ;;
  help|--help|-h) cmd_help ;;
  *)              err "Unknown command: $1"; echo ""; cmd_help; exit 1 ;;
esac
