# See https://help.github.com/articles/ignoring-files/ for about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NEVER commit real secrets — use .env.example as a template)
.env
.env.*
!.env.example

# database (contains user data, hashed passwords, API keys, encrypted env vars)
db/*.db
db/*.db-journal
db/*.sqlite
db/*.sqlite-journal

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# User ZIP uploads (Create Website Wizard)
/.uploads/

# Agent tool persisted outputs (may contain file reads with secrets)
/tool-results/

# Runtime / temp
/tmp/
