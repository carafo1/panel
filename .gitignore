# See https://help.github.com/articles/ignoring-files/ for about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Playwright e2e output and the saved test session (tests/e2e)
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
/tests/e2e/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NEVER commit real secrets — use .env.example as a template)
.env
.env.*
!.env.example

# database (contains user data, hashed passwords, API keys, encrypted env vars)
db/*.db
db/*.db-journal
db/*.sqlite
db/*.sqlite-journal
# the dev database lives under prisma/db (DATABASE_URL=file:./db/custom.db is
# relative to prisma/schema.prisma), including SQLite's WAL side files
prisma/db/*.db
prisma/db/*.db-journal
prisma/db/*.db-shm
prisma/db/*.db-wal
# throwaway database the CI build step points at (see .github/workflows/ci.yml)
ci-build.db*
prisma/ci-build.db*
*.sqlite-wal
*.sqlite-shm

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
# Only ignore root-level local-* scratch files, NOT src/lib/vps/local-exec.ts
/local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# User ZIP uploads (Create Website Wizard)
/.uploads/

# Agent tool persisted outputs (may contain file reads with secrets)
/tool-results/

# Runtime / temp
/tmp/

# Local storage (real databases, backups, caddyfile, project files — user data)
/storage/

# Agent internal context notes
/agent-ctx/

# Verification screenshots
project-detail-verify.png
*.verify.png
# Ad-hoc screenshots and pasted images (app images live in /public)
/*.png
/screenshots/
/upload/

# Development notes, old sandbox scripts and throwaway probes kept locally only
/_archive/
/worklog.md

# process id files
*.pid
