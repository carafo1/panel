# ─────────────────────────────────────────────────────────────────────────────
# Apsamo Panel — Environment Variables Template
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# Database (SQLite — file path relative to project root)
DATABASE_URL="file:./db/custom.db"

# NextAuth (used by legacy auth helpers if enabled)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# JWT (used by the current auth system in src/lib/auth.ts)
JWT_SECRET="generate-with-openssl-rand-base64-32"
JWT_EXPIRES_IN="7d"

# App
APP_URL="http://localhost:3000"
BRAND_NAME="Apsamo Panel"
BRAND_DOMAIN="apsamo.io"
FROM_EMAIL="noreply@apsamo.io"

# Encryption key for secrets at rest (env vars, DB passwords, wp passwords, API keys)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-with-32-byte-base64-key"

# Dynadot (Domain Registrar API) — optional, only for real domain registration
DYNADOT_API_KEY=""
DYNADOT_SECRET_KEY=""

# Stripe (Billing) — optional, only for real payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# SMTP (Email delivery) — optional
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# GitHub OAuth (for GitHub integration module) — optional
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# WaafiPay (alternative payment provider) — optional
WAAFIPAY_MERCHANT_ID=""
WAAFIPAY_API_KEY=""
WAAFIPAY_API_USER_ID=""
