# ════════════════════════════════════════════════════════════════════════════
# Apsamo Panel — Environment Variables Template
# ════════════════════════════════════════════════════════════════════════════
#
# Copy this file to `.env` and fill in real values.
#     cp .env.example .env
#
#   • Lines starting with `#` are comments.
#   • Required vars are marked [REQUIRED].
#   • Optional vars are marked [OPTIONAL] and have safe defaults in code.
#   • NEVER commit the real `.env` file. Only this template is tracked.
#
# Generate strong secrets with:
#     openssl rand -base64 32     # for JWT_SECRET / NEXTAUTH_SECRET / ENCRYPTION_KEY
#     openssl rand -hex 32        # for DYNADOT_SECRET_KEY / CRON_API_KEY
# ════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
# Database engine: "sqlite" (default) or "postgres" (for HA + pgvector AI search)
# [OPTIONAL] — defaults to "sqlite"
DB_ENGINE="sqlite"

# SQLite path (used when DB_ENGINE=sqlite).
# Example: file:./db/custom.db
#
# PostgreSQL connection string (used when DB_ENGINE=postgres).
# Example: postgresql://apsamo:password@localhost:5432/apsamo
#
# To switch from SQLite to PostgreSQL:
#   1. Run: bash deploy/scripts/install-postgres.sh
#   2. Run: bash deploy/scripts/switch-to-postgres.sh
#   3. (Optional) Populate AI embeddings: bun run scripts/populate-embeddings.ts
#
# [REQUIRED]
DATABASE_URL="file:./db/custom.db"


# ─────────────────────────────────────────────────────────────────────────────
# Auth — JWT (used by src/lib/auth.ts and the GitHub OAuth callbacks)
# ─────────────────────────────────────────────────────────────────────────────
# Secret used to sign JWTs. Generate with `openssl rand -base64 32`.
# [REQUIRED] — defaults to a weak dev-only key if unset (DO NOT rely on default in prod).
JWT_SECRET="replace-with-openssl-rand-base64-32"

# JWT lifetime (e.g. "1h", "7d", "30d"). Used by jsonwebtoken's `sign()`.
# [OPTIONAL] — currently hardcoded to "7d" in src/lib/auth.ts; kept here for
# future compatibility.
# JWT_EXPIRES_IN="7d"

# ─────────────────────────────────────────────────────────────────────────────
# Auth — NextAuth.js v4 (legacy helpers, currently unused by the main auth flow)
# ─────────────────────────────────────────────────────────────────────────────
# Public URL of the app. Set to your production origin in prod.
# [OPTIONAL]
NEXTAUTH_URL="http://localhost:3000"

# NextAuth secret. Generate with `openssl rand -base64 32`.
# [OPTIONAL] — only needed if you wire up NextAuth providers.
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"


# ─────────────────────────────────────────────────────────────────────────────
# Encryption — at-rest encryption for stored secrets (DB/API/SSH passwords, etc.)
# ─────────────────────────────────────────────────────────────────────────────
# 32-byte key used by src/lib/encryption.ts (AES-256-GCM). Must be a 64-char
# hex string OR a 44-char base64 string. Generate with:
#     openssl rand -hex 32
# [REQUIRED for production] — falls back to a deterministic dev-only key derived
# from JWT_SECRET if unset (with a loud warning). Never use the dev fallback in
# production — every secret you encrypt becomes trivially decryptable.
ENCRYPTION_KEY="replace-with-64-char-hex-string-from-openssl-rand-hex-32"


# ─────────────────────────────────────────────────────────────────────────────
# App / Branding
# ─────────────────────────────────────────────────────────────────────────────
# Public app URL — used for email verification links, OAuth callbacks, billing
# return URLs, etc. MUST be reachable from the user's browser.
# [OPTIONAL] — defaults to http://localhost:3000
APP_URL="http://localhost:3000"

# Same as APP_URL but exposed to the browser (NEXT_PUBLIC_* prefix). Used by
# client-side code (e.g. Stripe redirect URLs, WaafiPay callbacks).
# [OPTIONAL] — falls back to APP_URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Apex domain the panel is hosted on (used to derive default DNS hostnames
# and email mailbox addresses in src/lib/brand-config.ts).
# [OPTIONAL] — defaults to "apsamo.io"
BRAND_DOMAIN="apsamo.io"

# Subdomain pattern for hosted projects. `{slug}` is replaced by the project
# slug. Used to generate the default project URL.
# [OPTIONAL] — defaults to "{slug}.${BRAND_DOMAIN}"
APP_SUBDOMAIN_PATTERN="{slug}.${BRAND_DOMAIN}"

# Primary nameserver hostnames (advertised in WHOIS / NS records).
# [OPTIONAL] — default to ns1.${BRAND_DOMAIN} / ns2.${BRAND_DOMAIN}
NS1_HOSTNAME="ns1.apsamo.io"
NS2_HOSTNAME="ns2.apsamo.io"

# Mail server hostname (MX target, SMTP/IMAP host, webmail URL base).
# [OPTIONAL] — defaults to mail.${BRAND_DOMAIN}
MAIL_SERVER_HOSTNAME="mail.apsamo.io"


# ─────────────────────────────────────────────────────────────────────────────
# Email Mailboxes (system sender/recipient addresses)
# ─────────────────────────────────────────────────────────────────────────────
# All default to <role>@${BRAND_DOMAIN} when unset. See src/lib/brand-config.ts.
# [OPTIONAL]
NO_REPLY_EMAIL="no-reply@apsamo.io"
SUPPORT_EMAIL="support@apsamo.io"
BILLING_EMAIL="billing@apsamo.io"
ADMIN_EMAIL="admin@apsamo.io"


# ─────────────────────────────────────────────────────────────────────────────
# SMTP — outgoing transactional email (verification, password reset, etc.)
# ─────────────────────────────────────────────────────────────────────────────
# When ANY of these is missing, src/lib/email.ts runs in DEMO mode (logs the
# email to stdout instead of sending it). All [REQUIRED] if you want real email.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="postmaster@apsamo.io"
# NOTE: the code reads `SMTP_PASS` (not `SMTP_PASSWORD`).
SMTP_PASS="replace-with-smtp-password"

# Display name + sender address used in the `From:` header of outgoing mail.
# Falls back to "Apsamo Technology" <NO_REPLY_EMAIL> when unset.
# [OPTIONAL]
SMTP_FROM_NAME="Apsamo Panel"
SMTP_FROM_EMAIL="no-reply@apsamo.io"


# ─────────────────────────────────────────────────────────────────────────────
# Mailcow — email hosting API (mailbox provisioning, DKIM key retrieval)
# ─────────────────────────────────────────────────────────────────────────────
# When BOTH are unset, the Mailcow client (src/lib/mailcow.ts) runs in DEMO
# mode — every call returns a simulated success response so the rest of the
# platform can be exercised without a real Mailcow server.
# Base URL of your Mailcow instance (with or without /api/v1 suffix).
# [OPTIONAL] — but required for real mailbox provisioning + DKIM auto-fetch.
MAILCOW_API_URL="https://mail.apsamo.io"

# Mailcow API token (Mailcow admin → Configuration → Access → API key).
# [OPTIONAL] — required for real mailbox provisioning + DKIM auto-fetch.
MAILCOW_API_KEY="replace-with-mailcow-api-key"


# ─────────────────────────────────────────────────────────────────────────────
# Domains — Dynadot Registrar API (real domain registration)
# ─────────────────────────────────────────────────────────────────────────────
# When unset, domain registration/search runs in DEMO mode. Restored
# automatically on `bun run dev` by scripts/ensure-dynadot-env.ts.
# Get these from https://www.dynadot.com/account/api/apikey.html
# [OPTIONAL] — required for real domain registration, transfer, renewal.
DYNADOT_API_KEY="replace-with-dynadot-api-key"
DYNADOT_SECRET_KEY="replace-with-dynadot-secret-key"


# ─────────────────────────────────────────────────────────────────────────────
# Billing — Stripe
# ─────────────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
# When STRIPE_SECRET_KEY is unset, src/lib/stripe.ts runs in DEMO mode (returns
# a fake checkout session URL on `/billing/demo-checkout`).
# [OPTIONAL] — required for real payments.
STRIPE_SECRET_KEY="sk_test_replace-with-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_replace-with-stripe-webhook-secret"

# Default Stripe Price ID used when creating new subscriptions.
# [OPTIONAL] — falls back to env var lookup at checkout time.
STRIPE_PRICE_ID_DEFAULT="price_replace-with-stripe-price-id"

# Publishable key (currently only referenced by legacy billing UI; safe to
# leave empty).
# [OPTIONAL]
STRIPE_PUBLISHABLE_KEY="pk_test_replace-with-stripe-publishable-key"


# ─────────────────────────────────────────────────────────────────────────────
# Billing — WaafiPay (alternative payment provider, used in some regions)
# ─────────────────────────────────────────────────────────────────────────────
# When WAAFI_MERCHANT_ID is unset, WaafiPay payment routes return an error.
# See src/lib/waafi.ts for the full request/response flow.
# [OPTIONAL]
WAAFI_API_URL="https://api.waafipay.net"
WAAFI_MERCHANT_ID="replace-with-waafi-merchant-id"
WAAFI_API_KEY="replace-with-waafi-api-key"
WAAFI_API_USER_ID="replace-with-waafi-api-user-id"


# ─────────────────────────────────────────────────────────────────────────────
# GitHub OAuth (GitHub integration panel + repo/branch browsing)
# ─────────────────────────────────────────────────────────────────────────────
# Create an OAuth app at https://github.com/settings/developers
# Authorization callback URL: ${NEXT_PUBLIC_APP_URL}/api/github/oauth/callback
# When unset, the GitHub panel runs in DEMO mode (mock commits/repos).
# [OPTIONAL]
GITHUB_CLIENT_ID="replace-with-github-oauth-client-id"
GITHUB_CLIENT_SECRET="replace-with-github-oauth-client-secret"


# ─────────────────────────────────────────────────────────────────────────────
# VPS / Storage
# ─────────────────────────────────────────────────────────────────────────────
# Root directory on the panel host for local-mode (localhost server) project
# files, backups, and SQLite database files. Created lazily on first access.
# [OPTIONAL] — defaults to <cwd>/storage (i.e. /home/z/my-project/storage)
STORAGE_ROOT="/home/z/my-project/storage"

# Force VPS demo mode for ALL servers (skip real SSH/Docker calls even for
# servers with credentials). Useful for staging/preview deployments.
# Set to "1" or "true" to enable.
# [OPTIONAL] — defaults to disabled
VPS_DEMO_MODE="0"


# ─────────────────────────────────────────────────────────────────────────────
# Let's Encrypt (ACME account email for SSL cert issuance via Caddy)
# ─────────────────────────────────────────────────────────────────────────────
# Email used by Caddy when requesting Let's Encrypt certs for project domains.
# Falls back to ADMIN_EMAIL when unset.
# [OPTIONAL]
LE_EMAIL="admin@apsamo.io"


# ─────────────────────────────────────────────────────────────────────────────
# Cron / Background Jobs
# ─────────────────────────────────────────────────────────────────────────────
# Shared secret required to call the cron/monitor/admin job endpoints
# (used by external cron / systemd timers hitting /api/monitors/run and
# /api/admin/jobs/process). Send as `?key=...` or `X-Cron-Key` header.
# [OPTIONAL] — defaults to "deployhub-cron-key" (NOT secure; override in prod).
CRON_API_KEY="replace-with-openssl-rand-hex-32"


# ─────────────────────────────────────────────────────────────────────────────
# Misc / Runtime
# ─────────────────────────────────────────────────────────────────────────────
# Next.js dev/prod mode. Set to "production" for prod builds.
# [OPTIONAL] — defaults to "development"
# NODE_ENV="development"

# Port the Next.js dev server listens on. The Caddyfile gateway forces 3000
# internally — leave this unset unless you know what you're doing.
# [OPTIONAL] — defaults to 3000
# PORT="3000"

# SSH agent socket (set automatically by `ssh-agent` / `eval $(ssh-agent)`).
# When present, the ssh2 client uses it to talk to the agent for SSH key
# operations against remote VPS hosts. You do NOT normally set this in .env —
# it's an OS-level env var. Documented here for completeness.
# [OPTIONAL] — auto-set by ssh-agent
# SSH_AUTH_SOCK="/tmp/ssh-XXXXXX/agent.12345"


# ─────────────────────────────────────────────────────────────────────────────
# Authoritative DNS (PowerDNS) — makes ns1/ns2 real nameservers
# ─────────────────────────────────────────────────────────────────────────────
# Installed by deploy/scripts/setup-pdns.sh (API on localhost only). The key is
# written to /etc/powerdns/.api-key. Without these, "use our nameservers" is
# not offered to customers.
# [OPTIONAL]
# PDNS_API_URL="http://127.0.0.1:8081/api/v1/servers/localhost"
# PDNS_API_KEY="contents-of-/etc/powerdns/.api-key"


# ─────────────────────────────────────────────────────────────────────────────
# Security, SFTP and Cloudflare
# ─────────────────────────────────────────────────────────────────────────────
# Administrators must turn on two-factor authentication before admin tools
# work. Default: on in production, off in development. Only set "false" for a
# short emergency, then remove it again.
# [OPTIONAL]
# REQUIRE_ADMIN_2FA="true"

# Host and port customers use for SFTP (shown in each website's SSH / SFTP
# section). Defaults to CONNECT_HOSTNAME (connect.<BRAND_DOMAIN>) and port 22.
# [OPTIONAL]
# CONNECT_HOSTNAME="connect.apsamo.io"
# SFTP_HOSTNAME="connect.apsamo.io"
# SFTP_PORT="22"

# Cloudflare (customer CDN, WAF, DDoS). Prefer Admin → Servers → Cloudflare,
# which stores the token encrypted; these are a fallback. Without a token the
# pricing page does not advertise CDN/WAF/DDoS.
# Token permissions: Zone:Edit, Zone Settings:Edit, DNS:Edit, Cache Purge, Account:Read.
# [OPTIONAL]
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_ACCOUNT_ID=""
